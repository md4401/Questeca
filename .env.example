# ===== Obrigatório =====
# Neon (string pooled do projeto "questeca", branch principal)
DATABASE_URL=
# Segredo longo e aleatório (openssl rand -hex 32)
AUTH_SECRET=

# ===== Recomendado =====
# URL pública (na Vercel, se omitida, usa VERCEL_PROJECT_PRODUCTION_URL)
APP_URL=
# E-mail transacional (Resend): verificação de conta, recuperação de senha, convites
RESEND_API_KEY=
EMAIL_FROM="Questeca <no-reply@seudominio.com.br>"
# Exigir e-mail confirmado para entrar (ligue só depois de configurar o e-mail)
REQUIRE_EMAIL_VERIFICATION=false
# E-mails da equipe interna (acesso a /admin), separados por vírgula
STAFF_EMAILS=
# Quem recebe pedidos de demonstração por e-mail (opcional)
SUPPORT_EMAIL=

# ===== Opcional =====
# IA: leitura de fotos (cartões, tabelas, apostilas). Sem chave o produto funciona sem IA.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=
# Cobrança: stripe | none
BILLING_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PROFESSOR=

# ===== Somente testes/desenvolvimento (NUNCA em produção) =====
# NEON_FETCH_VIA_HOST=1  DEV_EMAIL_OUTBOX=1  BILLING_PROVIDER=mock  ALLOW_MOCK_BILLING=1  RATE_LIMIT_MULTIPLIER=1000
