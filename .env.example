# Banco (Neon) — string de conexão pooled
DATABASE_URL=
# URL pública do app (links de e-mail, convites)
APP_URL=http://localhost:3000
# Segredo para assinar links/tokens (openssl rand -hex 32)
AUTH_SECRET=
# E-mail transacional (Resend). Sem isso, links aparecem no log do servidor.
RESEND_API_KEY=
EMAIL_FROM="Questeca <no-reply@seudominio.com.br>"
# Exigir confirmação de e-mail para entrar (true só quando o e-mail estiver configurado)
REQUIRE_EMAIL_VERIFICATION=false
# IA (opcional). anthropic | none
AI_PROVIDER=none
ANTHROPIC_API_KEY=
# Cobrança (opcional). stripe | manual
BILLING_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PROFESSOR=
# E-mails com acesso à área interna (curadoria/moderação), separados por vírgula
STAFF_EMAILS=
